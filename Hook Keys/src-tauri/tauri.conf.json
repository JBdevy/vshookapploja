{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bronze Keys",
  "version": "1.0.0",
  "identifier": "com.hookdeveloper.hookkeys",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Bronze Keys", "width": 1128, "height": 673, "minWidth": 900, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Hook Developer",
    "shortDescription": "Instrumento musical profissional para performance ao vivo.",
    "longDescription": "Bronze Keys transforma seu computador em uma central profissional de timbres, efeitos, MIDI, arpejador, sequenciador e sintetizador para performance ao vivo.",
    "resources": {
      "../native-engine/assets/hook-b3": "hook-b3",
      "../native-engine/assets/pads": "pads"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Hook Developer"
      }
    }
  }
}
