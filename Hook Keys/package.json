{
  "name": "hook-keys",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:qr": "node scripts/dev-preview.mjs",
    "typecheck": "tsc -b",
    "test:password-recovery": "node scripts/test-password-recovery.mjs",
    "test:local-backup": "node --test scripts/test-local-backup.mjs",
    "test:sf2-flow": "node scripts/test-sf2-flow.mjs",
    "test:synth-controls": "node scripts/test-synth-controls.mjs",
    "test:patterns": "node scripts/test-pattern-modules.mjs",
    "test:library-visibility": "node scripts/test-library-module-visibility.mjs",
    "test:module-fader": "node scripts/test-module-fader.mjs",
    "test:player-startup": "node scripts/test-player-startup.mjs",
    "test:playlist-queue": "node scripts/test-playlist-queue.mjs",
    "test:native-tracks": "node scripts/test-native-tracks.mjs",
    "test:loop-metronome": "node scripts/test-loop-metronome.mjs",
    "generate:metronome-click": "node scripts/generate-metronome-click.mjs",
    "test:keyboard-style": "node scripts/test-keyboard-style.mjs",
    "test:input-keyboard": "node scripts/test-input-keyboard.mjs",
    "test:loading-transition": "node scripts/test-loading-transition.mjs",
    "test:desktop-shortcuts": "node scripts/test-desktop-browser-shortcuts.mjs",
    "test:rotary-expression": "node scripts/test-rotary-expression.mjs",
    "test:macos-pkg-sign": "node scripts/test-macos-pkg-sign.mjs",
    "verify:desktop-assets": "node scripts/verify-desktop-assets.mjs",
    "test:release": "node scripts/test-release.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "native:sync": "npm run build && cap sync && node scripts/fix-ios-spm-paths.mjs",
    "native:sync:ios": "npm run build && cap sync ios && node scripts/fix-ios-spm-paths.mjs",
    "native:add:android": "cap add android",
    "native:add:ios": "cap add ios",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/screen-orientation": "^8.0.0",
    "@tauri-apps/api": "^2.8.0",
    "@tonaljs/chord-detect": "^4.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@tauri-apps/cli": "^2.8.5",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "happy-dom": "^20.14.5",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
