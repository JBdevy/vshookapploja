<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp"><shape><solid android:color="@android:color/transparent" /></shape></item>
    <!-- Keep the complete square artwork inside Android 12's 192dp circular mask. -->
    <item android:width="128dp" android:height="128dp" android:gravity="center">
        <bitmap android:src="@drawable/catlive_splash" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
